# Copy to .env.local for local development. Never commit real values.
# NEXT_PUBLIC_* variables are exposed to the browser: never put a secret there.

# --- Site ---------------------------------------------------------------
# Public base URL (share images, sitemap, OAuth redirects).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Discord server invite. Leave empty to hide the button.
NEXT_PUBLIC_DISCORD_INVITE_URL=

# --- Supabase -----------------------------------------------------------
# Printed by `pnpm db:start` (local) or found in Project Settings > API (prod).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used by admin routes and the data pipeline. Never in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- OAuth providers (configured in Supabase Auth, task 4) --------------
SUPABASE_AUTH_DISCORD_CLIENT_ID=
SUPABASE_AUTH_DISCORD_SECRET=
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=

# --- Cloudflare Turnstile (anti-bot, task 4) ----------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Image storage (task 3) ---------------------------------------------
# "r2" (production, free egress), "supabase" (fallback) or "local"
# (development: files in public/card-images/, base URL /card-images).
IMAGE_STORAGE_PROVIDER=local
# Public base URL images are served from (R2 public bucket or custom domain).
NEXT_PUBLIC_IMAGE_BASE_URL=/card-images
# R2 credentials, used only by the pipeline (server side).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=deuce-cards

# --- Data pipeline (pipeline/README.md) --------------------------------
# Contact shown in the User-Agent, required by the Wikimedia API policy.
PIPELINE_CONTACT=
# Minimum delay between two requests to the same host, in seconds.
PIPELINE_MIN_INTERVAL_S=1.0
# Direct Postgres connection used by the pipeline (local Supabase default).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Referral and anti-abuse (server only, never NEXT_PUBLIC_) ---------
# Real values are private: set them in Vercel / .env.local, then run
# `pnpm settings:sync` to copy them into the database (private.settings).
# The samples below are deliberately generic placeholders, NOT the values
# used in production.
REFERRAL_REQUIRE_VERIFIED_EMAIL=true
REFERRAL_MIN_BOOSTERS_OPENED=1
REFERRAL_MIN_ACCOUNT_AGE_HOURS=1
REFERRAL_MAX_REWARDS_PER_DAY=1
REFERRAL_MAX_REWARDS_TOTAL=1
ABUSE_WEIGHT_NORMALIZED_EMAIL_MATCH=1
ABUSE_WEIGHT_DISPOSABLE_EMAIL_DOMAIN=1
ABUSE_WEIGHT_SIGNUP_BURST=1
ABUSE_SIGNUP_BURST_WINDOW_MINUTES=1
ABUSE_SCORE_THRESHOLD=1

# --- Observability (task 17) --------------------------------------------
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_SENTRY_DSN=
