# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# env template is committed
!.env.example

# python pipeline
__pycache__/
.venv/
pipeline/.cache/
pipeline/logs/*.log

# private notes (legal review, internal analysis): never published
/docs/private/

# downloaded or generated data: never committed (third-party licenses, size)
/data/
/pipeline/data/
/pipeline/downloads/
**/tennis_atp/
**/tennis_wta/
**/tennis_atp-*/
**/tennis_wta-*/

# local tools (e.g. gitleaks downloaded by scripts/scan-secrets.sh)
/.cache/
